# Orochia operator console. Copy to .env.local for local work; on a deployment these are app variables.

# The console's OWN database (operator account, sessions, operator log) — never Orochia's.
DATABASE_URL=postgresql://orochia_user:orochia_secret@localhost:5432/orochia_admin?sslmode=disable
# DATABASE_CA_CERT=   # managed PostgreSQL CA (App Platform: ${admin-db.CA_CERT})

# The single operator account: nobody signs up, there is no other user. 12+ characters.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# Orochia's API, and the service token both deployments share (32+ characters; Orochia: OROCHIA_ADMIN_API_TOKEN).
OROCHIA_API_URL=http://localhost:3000
OROCHIA_ADMIN_API_TOKEN=
NEXT_PUBLIC_OROCHIA_APP_URL=http://localhost:3000

# Comma-separated client addresses allowed to reach the console. Mandatory in production (empty = nobody).
ADMIN_ALLOWED_IPS=
