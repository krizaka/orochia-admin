{
  "name": "@krizaka/orochia-admin",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "description": "Operator console for Orochia: 2257 creator verification, content reports, payouts and treasury",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint . && krizaka-ratchet && ast-grep test --skip-snapshot-tests && node scripts/sg-ratchet.mjs",
    "test": "vitest run",
    "docs:generate": "UPDATE_DOCS=1 vitest run lib/env.test.ts",
    "e2e": "node e2e/walk.mjs",
    "lint:sg": "node scripts/sg-ratchet.mjs",
    "lint:sg:test": "ast-grep test --skip-snapshot-tests",
    "sg:ratchet:update": "node scripts/sg-ratchet.mjs --update",
    "sg:fix": "node scripts/sg-fix.mjs"
  },
  "dependencies": {
    "@krizaka/charts": "^0.1.0",
    "@krizaka/orochia-design-system": "^4.1.1",
    "@krizaka/tailwind": "^3.21.0",
    "@krizaka/tokens": "^3.21.0",
    "@krizaka/ui": "^3.21.0",
    "lucide-react": "^1.55.0",
    "next": "^16.4.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.51.0",
    "@krizaka/config": "^0.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.4.0",
    "playwright-core": "^1.64.0",
    "postcss": "^8.4.41",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.4",
    "vitest": "^5.0.3"
  },
  "license": "Apache-2.0",
  "overrides": {
    "postcss-selector-parser": "^7.1.6",
    "@krizaka/ui": "$@krizaka/ui",
    "@krizaka/tokens": "$@krizaka/tokens",
    "@krizaka/tailwind": "$@krizaka/tailwind"
  }
}
